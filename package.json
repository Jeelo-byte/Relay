{
  "name": "relay-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev apps/web --hostname 0.0.0.0",
    "build": "next build apps/web",
    "test": "node --test packages/normalize/normalize.test.mjs backend/api.test.mjs apps/web/lib/crypto.test.mjs apps/web/lib/matrix.test.mjs scripts/host-gateway.test.mjs",
    "normalize": "esbuild packages/normalize/index.ts --bundle --format=iife --global-name=RelayNormalize --target=es2020 --outfile=apple/RelayKit/Sources/RelayKit/Resources/normalize.js",
    "start": "next start apps/web --hostname 0.0.0.0",
    "messages:setup": "bash scripts/setup-messages.sh",
    "messages:status": "bash scripts/live-docker.sh ps",
    "messages:start": "bash scripts/live-docker.sh --profile bridges up -d synapse element whatsapp"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "libsodium-wrappers-sumo": "0.7.15",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
